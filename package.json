{
  "name": "wa_dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js dashboard with PostgreSQL repositories, local API routes and workers",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run start:user\" \"npm run start:admin\"",
    "build": "next build --turbopack",
    "start:user": "set USER_PORT=3001 && tsx server-user.ts",
    "start:admin": "set ADMIN_PORT=3001 && tsx server-admin.ts",
    "build:temp": "next build --turbopack --no-type-check",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:database": "tsx --test src/lib/database/client.test.ts",
    "db:setup": "tsx scripts/database/setup.ts",
    "verify:appearance": "node scripts/verify-appearance.mjs",
    "verify:frontend": "node scripts/verify-frontend.mjs",
    "worker:webhook": "tsx src/workers/webhooks.worker.ts",
    "worker": "npx tsx --watch src/workers/campaign.worker.ts",
    "verify-wallet": "tsx scripts/verify-wallet.ts",
    "worker:reminder": "npx tsx --watch src/workers/reminder.worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
