{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "wa-dashboard-user",
    "namespace": "default"
  },
  "spec": {
    "progressDeadlineSeconds": 360,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "wa-dashboard-user"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": 1,
        "maxUnavailable": 0
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "kubectl.kubernetes.io/restartedAt": "2026-10-10T17:02:08Z",
          "soft7.in/socket-release": "socket-20261024T103834Z",
          "soft7.in/source-patch-sha256": "410d28d5a1d70499b87ec701356d36194e32e923f5f86633123daa67ded7bd20",
          "soft7.in/source-revision": "fe085962d40ec5adb4cd0b65b3993017c95ec0bb"
        },
        "labels": {
          "app": "wa-dashboard-user"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "server-user.ts"
            ],
            "command": [
              "./node_modules/.bin/tsx"
            ],
            "env": [
              {
                "name": "USER_PORT",
                "value": "3000"
              },
              {
                "name": "NODE_OPTIONS",
                "value": "--max-old-space-size=768"
              }
            ],
            "envFrom": [
              {
                "secretRef": {
                  "name": "wa-dashboard-env"
                }
              }
            ],
            "image": "docker.io/library/wa-dashboard:socket-private-20261024T103834Z",
            "imagePullPolicy": "IfNotPresent",
            "livenessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/internal/socket-health",
                "port": "http",
                "scheme": "HTTP"
              },
              "periodSeconds": 15,
              "successThreshold": 1,
              "timeoutSeconds": 3
            },
            "name": "wa-dashboard-user",
            "ports": [
              {
                "containerPort": 3000,
                "name": "http",
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/internal/socket-health",
                "port": "http",
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 15,
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 3
            },
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "1536Mi"
              },
              "requests": {
                "cpu": "250m",
                "memory": "256Mi"
              }
            },
            "startupProbe": {
              "failureThreshold": 36,
              "httpGet": {
                "path": "/internal/socket-health",
                "port": "http",
                "scheme": "HTTP"
              },
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 3
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30
      }
    }
  }
}
