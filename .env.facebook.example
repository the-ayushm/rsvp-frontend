# Server-only Facebook Lead Ads configuration. Copy into .env.local.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Exact public dashboard URL; register this URI in Meta's Valid OAuth Redirect URIs.
FACEBOOK_REDIRECT_URI=https://your-dashboard.example/api/integrations/facebook/oauth/callback
# Use a Graph API version enabled for your Meta app.
FACEBOOK_GRAPH_VERSION=v25.0
# Optional Facebook Login for Business configuration ID.
FACEBOOK_LOGIN_CONFIG_ID=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACEBOOK_TOKEN_ENCRYPTION_KEY=
# Uses the existing DATABASE_URL for integration storage.
# Uses SOCKET_AUTH_API_URL (default https://hostapi.soft7.in/v1/auth/socket-session)
# to verify dashboard sessions with the backend.
